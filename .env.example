# Frontend build-time values for MSG91 OTP Widget custom UI.
# Use the OTP Widget token here, not the server-side Authkey.
VITE_MSG91_WIDGET_ID=your_msg91_widget_id
VITE_MSG91_TOKEN_AUTH=your_msg91_widget_token

# Backend runtime values. Keep the real Authkey only on the server.
MSG91_WIDGET_ID=your_msg91_widget_id
MSG91_AUTH_KEY=your_msg91_server_authkey
